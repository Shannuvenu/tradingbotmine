# Copy this file to .env (INSTALL_WINDOWS.bat does it) and fill in values locally.
# NEVER paste these values into chats, screenshots, or GitHub.

# From https://account.upstox.com/developer/apps  ("API Key" = client id, "API Secret" = client secret)
UPSTOX_CLIENT_ID=
UPSTOX_CLIENT_SECRET=
# Must match EXACTLY the Redirect URL saved in your Upstox app. LOGIN.bat listens on this address.
UPSTOX_REDIRECT_URI=http://127.0.0.1:8765/callback

# Optional: a token generated manually on the developer portal. Normally leave blank and use LOGIN.bat
# (tokens expire at 03:30 IST daily).
UPSTOX_ACCESS_TOKEN=

# Optional: override sandbox host if Upstox changes it
# UPSTOX_SANDBOX_BASE=https://api-sandbox.upstox.com
